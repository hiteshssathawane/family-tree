{
  "app": {
    "familyName": "The Family Tree",
    "familyNameMarathi": "आपले कुटुंब",
    "tagline": "आपले कुटुंब . हमारा परिवार . Our Heritage",
    "defaultLanguage": "en",
    "supportedLanguages": [
      "en",
      "mr",
      "hi"
    ]
  },
  "media": {
    "provider": "cloudflare-r2",
    "r2PublicUrl": "https://pub-51dbdc7eb2f346efb74d0ec6e3b08829.r2.dev",
    "maxPhotoSizeMB": 5,
    "allowedTypes": [
      "image/jpeg",
      "image/png",
      "image/webp"
    ],
    "_comment": "Deploy metadata only — nothing reads this at runtime. The live values come from the PHOTO_* keys in .env, injected as window.PHOTO_CONFIG by scripts/encrypt.js and mirrored into worker/wrangler.toml [vars].",
    "upload": {
      "outputFormat": "image/webp",
      "webpQuality": 0.82,
      "profile": { "width": 800, "height": 800, "aspect": "1:1" },
      "background": { "width": 1600, "height": 534, "aspect": "3:1" },
      "keyPattern": "<profile|background>_<personId lowercased>.webp",
      "cacheControl": "public, max-age=60"
    }
  },
  "github": {
    "owner": "hiteshssathawane",
    "repo": "family-tree",
    "branch": "main",
    "dataPath": "data/family.json"
  },
  "workerUrl": "",
  "r2BaseUrl": "",
  "photoBaseUrl": "https://pub-51dbdc7eb2f346efb74d0ec6e3b08829.r2.dev",
  "features": {
    "totp": false,
    "multiLanguage": true,
    "calendarView": true,
    "adminPanel": true,
    "bulkImport": true,
    "gedcomExport": false,
    "pwa": true,
    "watermark": false,
    "printDisabled": true
  },
  "privacy": {
    "viewerHidesContactInfo": true,
    "viewerHidesFullAddress": true,
    "livingDOBVisibleToViewer": true
  }
}
